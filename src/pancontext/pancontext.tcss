Screen {
    background: #111214;
    color: #d6d7d9;
}

Header {
    background: #1a1b1e;
    color: #f0f0f0;
}

Footer {
    background: #1a1b1e;
    color: #d6d7d9;
}

#workspace {
    height: 1fr;
    padding: 1 2;
}

#input-panel,
#results-panel {
    border: round #4b4d52;
    background: #191a1d;
    padding: 1 2;
}

#input-panel {
    width: 40%;
    min-width: 42;
    margin-right: 1;
}

#results-panel {
    width: 60%;
}

.panel-kicker {
    height: 1;
    color: #e2e2e3;
    text-style: bold;
    margin-bottom: 1;
}

.field-label {
    color: #adafb3;
    margin-top: 1;
}

Input,
Select {
    margin-bottom: 0;
}

Input,
SelectCurrent {
    border: tall #3d3f44;
    background: #101113;
    color: #e7e7e8;
}

Input:focus,
Select:focus > SelectCurrent {
    border: tall #92949a;
}

Select > SelectOverlay {
    border: tall #5f6167;
    background: #191a1d;
    color: #e7e7e8;
}

Select > SelectOverlay > .option-list--option-highlighted {
    background: #55575d;
    color: #ffffff;
}

Button {
    background: #2a2b2f;
    color: #dedfe1;
    border: tall #4b4d52;
}

Button:hover {
    background: #3a3b40;
    border: tall #777980;
}

Button.-primary {
    background: #55575d;
    color: #ffffff;
    border: tall #777980;
}

Button.-primary:hover {
    background: #66686f;
}

#allele-row {
    height: auto;
}

.allele-field {
    width: 1fr;
}

.allele-field:first-child {
    margin-right: 1;
}

#actions {
    height: auto;
    margin-top: 1;
}

#actions Button {
    margin-right: 1;
}

#coordinate-note {
    height: auto;
    margin-top: 1;
    padding: 1;
    color: #b7b8bb;
    background: #242529;
    border-left: thick #5f6167;
}

#status {
    height: 3;
    padding: 1;
    margin-bottom: 1;
    background: #242529;
    border-left: thick #5f6167;
}

#status.success {
    color: #e3e3e4;
    border-left: thick #8d8f95;
}

#status.error {
    color: #f1f1f2;
    background: #303135;
    border-left: thick #c7c8cb;
}

#coordinate-table {
    height: 16;
    margin-bottom: 1;
}

#preview {
    height: 7;
    padding: 1 2;
    margin-bottom: 1;
    background: #101113;
    border: round #3d3f44;
}

#interpretation {
    height: auto;
    min-height: 5;
    padding: 1 2;
    color: #c9cacc;
    background: #242529;
}

Screen.-compact #workspace {
    padding: 0 1;
}

Screen.-compact #input-panel {
    width: 36%;
    min-width: 30;
    padding: 0 1;
}

Screen.-compact #results-panel {
    width: 64%;
    padding: 0 1;
}

Screen.-compact #coordinate-table {
    height: 15;
}
