Screen {
    background: #07111a;
    color: #d7e3ea;
}

Header {
    background: #0b1d29;
    color: #f4fbff;
}

Footer {
    background: #0b1d29;
}

#workspace {
    height: 1fr;
    padding: 1 2;
}

#input-panel,
#results-panel {
    border: round #2a8195;
    background: #0b1822;
    padding: 1 2;
}

#input-panel {
    width: 40%;
    min-width: 42;
    margin-right: 1;
}

#results-panel {
    width: 60%;
}

.panel-kicker {
    height: 1;
    color: #63e6be;
    text-style: bold;
    margin-bottom: 1;
}

.field-label {
    color: #9fb7c3;
    margin-top: 1;
}

Input {
    margin-bottom: 0;
    border: tall #284b5c;
    background: #07111a;
}

Input:focus {
    border: tall #63e6be;
}

#allele-row {
    height: auto;
}

.allele-field {
    width: 1fr;
}

.allele-field:first-child {
    margin-right: 1;
}

#actions {
    height: auto;
    margin-top: 1;
}

#actions Button {
    margin-right: 1;
}

#coordinate-note {
    height: auto;
    margin-top: 1;
    padding: 1;
    color: #8fa7b3;
    background: #102432;
    border-left: thick #2a8195;
}

#status {
    height: 3;
    padding: 1;
    margin-bottom: 1;
    background: #102432;
    border-left: thick #2a8195;
}

#status.success {
    color: #b8f2df;
    border-left: thick #38b27d;
}

#status.error {
    color: #ffc9c9;
    border-left: thick #d95763;
}

#coordinate-table {
    height: 13;
    margin-bottom: 1;
}

#preview {
    height: 7;
    padding: 1 2;
    margin-bottom: 1;
    background: #07111a;
    border: round #284b5c;
}

#interpretation {
    height: auto;
    min-height: 5;
    padding: 1 2;
    color: #c2d2da;
    background: #102432;
}

Screen.-compact #workspace {
    padding: 0 1;
}

Screen.-compact #input-panel {
    width: 36%;
    min-width: 30;
    padding: 0 1;
}

Screen.-compact #results-panel {
    width: 64%;
    padding: 0 1;
}

Screen.-compact #coordinate-table {
    height: 12;
}
